# ============================================================
# YT 品牌家具官网 - .gitignore
# 依据：项目开发实施方案 v2.2 第 9 章 Phase 0 步骤 1.4
# ============================================================

# ---------- Python ----------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ---------- Node ----------
node_modules/
dist/

# ---------- 环境变量（保留 .example 模板，忽略真实配置） ----------
.env
.env.*
!.env.example
!.env.*.example

# ---------- 数据库 ----------
*.db
*.sqlite3
api/yt.db

# ---------- 上传文件 ----------
api/uploads/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
.DS_Store

# ---------- 日志 ----------
*.log

# ---------- 构建产物中间态 ----------
*.tsbuildinfo
dist.bak.*

# ---------- 依赖缓存（npm cacache，可再生，体积大不入库） ----------
dependency/*/.npmcache/

# ---------- 安装过程残留（废弃目录，待清理） ----------
frontend/_nm_broken/
frontend/_nm_old/

# ---------- vite 构建临时文件 ----------
*.timestamp-*.mjs
*.timestamp-*.js
