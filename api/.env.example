# ============================================================
# YT 品牌家具官网 - API 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# 依据：项目开发实施方案 v2.2 第 9 章 Phase 0 步骤 1.3
# ============================================================

# JWT 签名密钥（生产务必替换为高强度随机值，建议 32+ 位）
JWT_SECRET=change-me-to-a-long-random-secret

# JWT 访问令牌有效期（小时）
JWT_EXPIRE_HOURS=24

# SQLite 数据库文件名（位于 api/ 目录下）
DB_PATH=yt.db

# 允许跨域的前端源（逗号分隔；开发期含前后台两个端口）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 初始系统管理员账号（用户名固定为 10000，去 admin 化约束）的默认密码
INIT_SYSADMIN_PASSWORD=YT@2026

# 对象存储（OSS / COS）配置
# 开发期 OSS_PROVIDER=local 走本地模拟上传，生产再切换为 oss / cos
OSS_PROVIDER=local
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# 开发期本地上传文件的公网/相对访问前缀
OSS_PUBLIC_BASE_URL=/uploads
